{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "name", "campaign", "canonPolicy", "publicAudience", "defaultVisibility"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "campaign": { "type": "string", "minLength": 1 },
    "canonPolicy": { "type": "string", "minLength": 1 },
    "publicAudience": { "const": "players" },
    "defaultVisibility": { "enum": ["player", "dm-only"] }
  }
}

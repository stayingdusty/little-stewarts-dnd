{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://little-stewarts.local/entity.schema.json",
  "title": "Knowledge Base Entity",
  "type": "object",
  "required": ["id", "domain", "name", "summary", "tags", "source"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "domain": {
      "type": "string",
      "enum": ["character", "npc", "location", "encounter", "lore", "secret"]
    },
    "name": { "type": "string", "minLength": 1 },
    "summary": { "type": "string" },
    "details": { "type": "string" },
    "aliases": {
      "type": "array",
      "items": { "type": "string" }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    },
    "relatedIds": {
      "type": "array",
      "items": { "type": "string" }
    },
    "source": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "type": "string" },
        "path": { "type": "string" },
        "arc": { "type": "string" },
        "chapter": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["id", "campaignId", "arc", "chapter", "title", "visibility", "canonStatus", "summary", "majorOutcome", "metadata", "sections", "evidence", "source"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "campaignId": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "arc": { "type": "integer", "minimum": 1 },
    "chapter": { "type": "integer", "minimum": 1 },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "visibility": { "enum": ["player", "dm-only"] },
    "canonStatus": { "enum": ["proposed", "confirmed", "superseded", "unresolved"] },
    "summary": { "type": "string", "minLength": 1 },
    "majorOutcome": { "type": "string", "minLength": 1 },
    "metadata": {
      "type": "object",
      "required": ["campaign", "arc", "chapter", "coreShift"],
      "additionalProperties": { "type": "string" }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["heading", "bodyHtml"],
        "properties": {
          "heading": { "type": "string", "minLength": 1 },
          "bodyHtml": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": { "type": "array", "minItems": 1 },
    "source": {
      "type": "object",
      "required": ["type", "path", "anchor"],
      "properties": {
        "type": { "const": "generated_playthrough_summary" },
        "path": { "const": "playthrough-summaries/index.html" },
        "anchor": { "type": "string", "pattern": "^[a-z0-9-]+$" }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["sessionId", "status", "visibility", "updates"],
  "properties": {
    "sessionId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["proposed", "approved", "applied", "rejected"] },
    "visibility": { "const": "dm-only" },
    "updates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["characterId", "field", "proposedValue", "evidence", "confidence", "reviewState"],
        "properties": {
          "characterId": { "type": "string", "pattern": "^character-" },
          "field": { "type": "string", "minLength": 1 },
          "previousValue": {},
          "proposedValue": {},
          "evidence": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "confidence": { "enum": ["high", "medium", "low", "illegible"] },
          "reviewState": { "enum": ["pending", "confirmed", "rejected"] }
        }
      }
    }
  }
}

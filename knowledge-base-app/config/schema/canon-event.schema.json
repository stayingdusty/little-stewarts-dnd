{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://little-stewarts.local/canon-event.schema.json",
  "title": "Canon Event",
  "type": "object",
  "required": ["id", "title", "summary", "participants", "locations", "visibility", "canonStatus", "evidence", "source"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "summary": { "type": "string" },
    "participants": {
      "type": "array",
      "items": { "type": "string" }
    },
    "locations": {
      "type": "array",
      "items": { "type": "string" }
    },
    "visibility": { "enum": ["player", "dm-only"] },
    "canonStatus": { "enum": ["proposed", "confirmed", "superseded", "unresolved"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "path"],
        "properties": {
          "type": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string" },
        "arc": { "type": "string" },
        "chapter": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
